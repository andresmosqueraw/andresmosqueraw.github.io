  title        = {Thought Anchors for Social Bias: Which Reasoning Steps Matter in Extended Thinking LLMs on Latin American Scenarios},
  author       = {Mosquera-Hernandez, Andres},
  howpublished = {Winner, Global South AI Safety Hackathon (Apart Research). Submitted to GeBNLP @ ACL 2026},
  year         = {2026},
  abstract     = {Winner of the Global South AI Safety Hackathon, competing solo among 217 teams. I adapt the Thought Anchors resampling framework to chain-of-thought interpretability and attribute which reasoning steps push extended-thinking LLMs (Claude Sonnet 4.6, Gemini 2.5 Flash, Qwen3.7-Plus) toward stereotypical outputs in Latin American scenarios. Reproducible pipeline, paper, and interactive demo built in about 24 hours.}
