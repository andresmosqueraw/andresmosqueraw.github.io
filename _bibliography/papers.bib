@misc{mosquera2026retime,
  abbr         = {ICPM},
  bibtex_show  = {true},
  selected     = {true},
  title        = {How Multiple Explanations Behind a Decision Compose in Prescriptive Process Monitoring},
  author       = {Mosquera-Hernandez, Andres and Gonz{\'a}lez-Rojas, Oscar},
  howpublished = {Under review at the International Conference on Process Mining (ICPM)},
  year         = {2026},
  abstract     = {A prescriptive process monitoring recommendation comes from three models: a risk model, an effect model, and a timing model that decides when to act. We design RETIME, a method that composes their three explanations. On BPIC2017 and BPIC2012, the effect model gives most of the decision's reasons (56.4--80.5\%), the risk model 9.2--15.9\%, and the timing model adds 10.3--30.1\%. Deletion tests, baseline sensitivity checks, and path patching test whether the composed explanation can be trusted.}
}

