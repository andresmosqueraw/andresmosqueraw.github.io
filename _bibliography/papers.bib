@misc{daza2026costly,
  abbr         = {Apart},
  bibtex_show  = {true},
  selected     = {true},
  title        = {Rare Once It Costs Anything: Costly Cooperation Between LLM Agents},
  author       = {Daza Jaimes, David Jose and Mosquera-Hernandez, Andres and Gelves Cabrera, Victor Manuel},
  howpublished = {AI Incident Response Sprint, Apart Research. Top 25\% of 230+ projects},
  year         = {2026},
  html         = {https://apartresearch.com/sprints/projects/rare-once-it-costs-anything-costly-cooperation-between-llm-agents-loz0},
  abstract     = {Do LLM agents pay a cost to help others when helping is useless to their own task? Six tool-using agents, each with its own task and step budget, were asked by a scripted requester for a key none of them needed. Across 127 runs, 23.9\% of agents paid to deliver it, against about 47\% when delivery was free. Once helping costs anything, few agents pay, and the size of the price matters far less than its existence. The instrument uses a hash-chained run ledger and a preregistered contrast.}
}

@misc{mosquera2026retime,
  abbr         = {ICPM},
  bibtex_show  = {true},
  selected     = {true},
  title        = {How Multiple Explanations Behind a Decision Compose in Prescriptive Process Monitoring},
  author       = {Mosquera-Hernandez, Andres and Gonz{\'a}lez-Rojas, Oscar},
  howpublished = {Under review at the International Conference on Process Mining (ICPM)},
  year         = {2026},
  abstract     = {A prescriptive process monitoring recommendation comes from three models: a risk model, an effect model, and a timing model that decides when to act. We design RETIME, a method that composes their three explanations. On BPIC2017 and BPIC2012, the effect model gives most of the decision's reasons (56.4--80.5\%), the risk model 9.2--15.9\%, and the timing model adds 10.3--30.1\%. Deletion tests, baseline sensitivity checks, and path patching test whether the composed explanation can be trusted.}
}

